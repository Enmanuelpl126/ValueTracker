# Force primary languages for source files
# Treat JSX files as JavaScript so GitHub shows JavaScript (React code)
*.jsx linguist-language=JavaScript
*.js linguist-language=JavaScript
src/**/*.jsx linguist-language=JavaScript
src/**/*.js linguist-language=JavaScript
# Keep CSS and HTML as their respective languages
*.css linguist-language=CSS
*.html linguist-language=HTML

# Mark tooling/config files as vendored (excluded from stats)
vite.config.js linguist-vendored
tailwind.config.js linguist-vendored
postcss.config.js linguist-vendored
eslint.config.js linguist-vendored

# Keep hidden windsurf plans ignored by git but do not affect language stats
.windsurf/** linguist-vendored
